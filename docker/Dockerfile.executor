ARG REGISTRY=
ARG TAG=:latest

FROM ${REGISTRY}simbricks-runner${TAG} AS executor

ARG PACKER_VERSION=1.11.2

USER root
RUN mkdir /global_input && chown simbricks:simbricks /global_input

# Tooling for simbricks-imagebuild-guestfs. Not a conda dependency: libguestfs
# is not packaged for conda. qemu-img is, and comes with simbricks-qemu-sim-bin
# below. linux-image-generic supplies the kernel the direct backend builds its
# appliance from, which the distro ships mode 0600 and this user has to read.
# xorriso is for simbricks-imagebuild-packer: packer builds the cloud-init seed
# CD with it. It is not packaged for conda either.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libguestfs-tools \
        linux-image-generic \
        xorriso \
 && rm -rf /var/lib/apt/lists/* \
 && chmod 0644 /boot/vmlinuz-*
ENV LIBGUESTFS_BACKEND=direct

USER simbricks

RUN micromamba install -y simbricks-qemu-sim-bin \
                          simbricks-gem5-sim-bin \
                          simbricks-femu-sim-bin \
                          simbricks-ns3-sim-bin \
                          simbricks-i40e-sim-bm-bin \
                          simbricks-e1000-sim-bm-bin \
                          simbricks-net-base-sim-bin \
                          simbricks-mem-base-sim-bin \
                          simbricks-memnet-base-sim-bin \
                          simbricks-corundum-sim-rtl-bin \
                          simbricks-dist \
                          simbricks-imagebuild-guestfs \
                          simbricks-imagebuild-packer \
                          packer=${PACKER_VERSION} \
  && micromamba clean --all -y \
  && rm -rf $MAMBA_ROOT_PREFIX/include

# The builder plugin simbricks-imagebuild-packer's template asks for, so a
# build on the runner does not have to fetch it.
RUN micromamba run -- packer plugins install github.com/hashicorp/qemu

ENV GLOBAL_INPUT_DIR=/global_input

COPY runner_config_local.yaml /runner_config.yaml

ENTRYPOINT ["/run_local_executor.sh"]